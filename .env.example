# Copy to .env and adjust values.
# Backend services (docker-compose / API)
NODE_ENV=development
PORT=3000

# Host port for the nginx reverse proxy (default 8080)
NGINX_PORT=8080

DATABASE_URL=mysql://campus_app:change_me@mysql:3306/campus_news
REDIS_URL=redis://redis:6379

# JWT secrets (generate strong values, never commit production secrets)
JWT_ACCESS_SECRET=replace_me_with_strong_secret
JWT_REFRESH_SECRET=replace_me_with_strong_secret

# Firebase Cloud Messaging (for push notifications)
FCM_PROJECT_ID=replace_me
FCM_CLIENT_EMAIL=replace_me
FCM_PRIVATE_KEY=replace_me